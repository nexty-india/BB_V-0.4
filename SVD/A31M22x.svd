    <peripheral> <!--COMPARATOR-->
      <name>CMP</name>
      <version>1.0</version>
      <description>Comparator</description>
      <groupName>CMP</groupName>
      <baseAddress>0x4000B380</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x40</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>CMP</name>
        <value>25</value>
      </interrupt>
      <registers>
        <register>
          <name>CONF</name>
          <description>Comparator Configure Register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
