                </enumeratedValue>
                <enumeratedValue>
                  <name>High_Level</name>
                  <description>High level during dead-time</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTCLK</name>
