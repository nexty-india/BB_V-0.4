    <peripheral> <!--CFMC-->
      <name>SRAM</name>
      <version>1.0</version>
      <description>SRAM MEMORY CONTROLLER</description>
      <groupName>SRAM</groupName>
      <baseAddress>0x41003000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SRAM</name>
        <value>24</value>
      </interrupt>
      <registers>
        <register>
          <name>CONF</name>
          <description>SRAM Memory Configuration Register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>WALK1S</name>
              <description>Walking 1s algorithm enable</description>
              <bitRange>[01:01]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WALK0S</name>
              <description>Walking 0s algorithm enable</description>
              <bitRange>[00:00]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>SRAM Memory Control Register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>INTEN</name>
              <description>SRAM Interrupt enable</description>
              <bitRange>[08:08]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ABORT</name>
              <description>Fault Test Abort enable</description>
              <bitRange>[01:01]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>START</name>
              <description>Fault Test START enable</description>
              <bitRange>[00:00]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STAT</name>
          <description>SRAM Memory Status Register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>ERROR</name>
              <description>fault test start without WALK0S and walking 1s algorithm enable Status</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ABORT</name>
              <description>Interrupt Abort Status</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FAIL</name>
              <description>Interrupt Fail Status</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PASS</name>
              <description>Interrupt Pass Status</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DONE</name>
              <description>Fault Test Done Status</description>
              <bitRange>[08:08]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>Fault Test Busy Status</description>
              <bitRange>[00:00]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FTFADDR</name>
          <description>SRAM FAULT TEST FAIL ADDRESS Register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>FTFADDR</name>
              <description>SRAM Fault Test Fail Address</description>
              <bitRange>[12:00]</bitRange>
              <access>read-only</access>
            </field>            
          </fields>
        </register>
        <register>
          <name>FTFBITR</name>
          <description>SRAM FAULT TEST FAIL BIT Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>FTFBIT</name>
              <description>SRAM Fault Test Fail Bit</description>
              <bitRange>[31:00]</bitRange>
              <access>read-only</access>
            </field>            
          </fields>
        </register>
        <register>
          <name>FTFPADDR</name>
          <description>SRAM Fault Test Fail PTR Address Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>FTFPADDR</name>
              <description>SRAM Fault Test Fail PTR Address</description>
              <bitRange>[12:00]</bitRange>
              <access>read-only</access>
            </field>            
          </fields>
        </register>
        <register>
          <name>TESTCTRL</name>
          <description>SRAM TEST Control Register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xffffffff</resetMask>
          <fields>
            <field>
              <name>INV_CHK_PTN</name>
              <description>inverse check-board write/status</description>
              <bitRange>[03:03]</bitRange>
              <access>read-write</access>
            </field>            
            <field>
              <name>CHK_BD_PTN</name>
              <description>check-board pattern write/status</description>
              <bitRange>[02:02]</bitRange>
              <access>read-write</access>
            </field>            
            <field>
              <name>ALL1_PTN</name>
              <description>All 1 pattern write/status</description>
              <bitRange>[01:01]</bitRange>
              <access>read-write</access>
            </field>            
            <field>
              <name>ALL0_PTN</name>
              <description>All 0 pattern write/status</description>
              <bitRange>[00:00]</bitRange>
              <access>read-write</access>
            </field>            
          </fields>
        </register>                        
      </registers>      
    </peripheral>
    <peripheral> <!--DMA-->
      <name>DMA0</name>
      <version>1.0</version>
      <description>Direct Memory Access Control 0</description>
      <groupName>DMA</groupName>
      <headerStructName>DMA</headerStructName>
