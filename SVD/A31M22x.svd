    <peripheral> <!--PA-->
      <name>PA</name>
      <version>1.0</version>
      <description>General Port A</description>
      <groupName>PCU</groupName>
      <headerStructName>PCU</headerStructName>
      <baseAddress>0x42000000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>GPIOA</name>
        <value>11</value>
      </interrupt>
      <registers>
